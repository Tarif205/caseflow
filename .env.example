# Copy this file to .env and fill in real values. Never commit .env.
# This file holds names and safe defaults only, never a real key.

# Chat model (PRD section 8.2). Switch local <-> hosted by changing these only.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:4b
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120

# Day 3 baseline calibration; provisional until independent answer/refusal review.
MIN_SIMILARITY=0.691243
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Embeddings: runs on CPU inside the service
EMBED_PROVIDER=fastembed
EMBED_MODEL=BAAI/bge-small-en-v1.5
# Windows: G:/fastembed-cache; Linux: .cache/fastembed
FASTEMBED_CACHE_PATH=

# Postgres with pgvector (local Compose on Day 1, Neon when deployed)
DATABASE_URL=

# Optional local integration-test database. Never point tests at Neon/production.
TEST_DATABASE_URL=

# Langfuse Cloud settings; populate only in the ignored .env.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Deployment database; not used automatically by local development.
NEON_DATABASE_URL=

# Token values are generated by copilot provision-token into .env, never printed.
# Example setting names: NORTHWIND_API_TOKEN and CONTOSO_API_TOKEN.
# Do not add empty token placeholders before running provision-token.

# Day 6 trusted local operator services. HTTPS is required for remote tool URLs.
KNOWLEDGE_API_URL=http://127.0.0.1:8001
MOCK_BACKEND_URL=http://127.0.0.1:8004
# Local agent read tokens are generated into .env by copilot provision-token:
# NORTHWIND_AGENT_API_TOKEN and CONTOSO_AGENT_API_TOKEN (no empty placeholders).
# Day 9 local roles (generated separately; never add empty token placeholders):
# NORTHWIND_WORKER_API_TOKEN: read/agent plus refunds:propose and refunds:execute.
# NORTHWIND_APPROVER_API_TOKEN: refund:approve only. Never a model tool.
# Local checkpoint default: .cache/agent-checkpoints.sqlite (git-ignored).

# Day 10 HTTP services. Deployment Compose supplies PostgreSQL checkpoints.
AGENT_ROOT_PATH=
AGENT_TRACING_ENABLED=false
# Opt in only for the internal backend with the authoritative approval ledger.
MOCK_REFUNDS_ENABLED=false
